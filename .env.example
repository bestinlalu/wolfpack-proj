# Copy to .env and fill in. .env is gitignored; never commit real keys.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-flash-lite-latest
# Free keys allow about 20 requests per model per day (about 3 cases). Cap Gemini cases per run; 0 = no limit.
# GEMINI_MAX_CASES=3
# Prices used only for the replay cost estimate (USD per million tokens); check Google's pricing page.
# GEMINI_PRICE_INPUT_PER_M=0.50
# GEMINI_PRICE_OUTPUT_PER_M=3.00
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# BODYLAB_WRIST_OFFSET_HOURS=0
# Shared password for the demo sign-in screen; leave empty for no password.
# BODYLAB_DEMO_PASSWORD=
